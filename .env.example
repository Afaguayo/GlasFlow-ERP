# GlasFlow ERP — environment configuration (copy values into your shell, launch profile or user-secrets).
# ASP.NET Core maps "__" to ":" (Auth__JwtKey -> Auth:JwtKey). Never commit real values; .env is git-ignored.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- Database ---------------------------------------------------------------
# SqlServer (default) or Sqlite (no SQL Server needed; used by the automated tests)
Database__Provider=SqlServer
ConnectionStrings__GlasFlow=Server=.\SQLEXPRESS;Database=GlasFlowERP;Trusted_Connection=True;TrustServerCertificate=True
ConnectionStrings__GlasFlowSqlite=Data Source=glasflow.db
Database__AutoMigrate=true
Database__InstallSqlObjects=true
Database__Seed=true

# --- Authentication -----------------------------------------------------------
# Required outside Development: at least 32 random characters.
Auth__JwtKey=
# Password for the demo users admin / operador / consulta. If empty in Development,
# a random one is generated on first seed and printed to the console log.
Auth__DemoPassword=
Auth__TokenMinutes=480

# --- AI assistant (optional; the app works fully without it) ------------------
# none | anthropic | openai (any OpenAI-compatible chat-completions endpoint)
Ai__Provider=none
# Either variable works; prefer a secret store in real deployments.
GLASFLOW_AI_API_KEY=
Ai__Model=
Ai__BaseUrl=

# --- Business rules / automation ----------------------------------------------
Inventory__AllowNegativeStock=false
Automation__InventoryCheckMinutes=15

# --- CORS (only needed when the UI is served from another origin) ------------
# Cors__AllowedOrigins__0=http://localhost:3000

# --- Desktop client ---------------------------------------------------------
GLASFLOW_API_URL=http://localhost:5080
