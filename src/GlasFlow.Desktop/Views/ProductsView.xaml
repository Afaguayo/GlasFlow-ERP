<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GlasFlow.Desktop.ViewModels">

    <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Productos" Style="{StaticResource H1}" Margin="0,0,0,12"/>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <WrapPanel>
                    <TextBox Width="260" Margin="0,0,10,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por código o nombre">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Buscar" Style="{StaticResource Primary}" Command="{Binding SearchCommand}"/>
                    <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,24,0"/>
                    <Button Content="Nuevo producto…" Command="{Binding NewCommand}"/>
                    <Button Content="Editar…" Command="{Binding EditCommand}"/>
                    <Button Content="Desactivar" Style="{StaticResource Danger}" Command="{Binding DeactivateCommand}"/>
                </WrapPanel>
            </Border>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Siguiente ›" Command="{Binding NextCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="‹ Anterior" Command="{Binding PrevCommand}" Margin="0"/>
                <TextBlock Text="{Binding PageText}" Style="{StaticResource Muted}"/>
            </DockPanel>

            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding ProductCode}" Width="110"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="2*"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="*"/>
                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="60"/>
                    <DataGridTextColumn Header="Costo" Binding="{Binding Cost, StringFormat=C2}" Width="100"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding SellingPrice, StringFormat=C2}" Width="100"/>
                    <DataGridTextColumn Header="Disponible" Binding="{Binding TotalAvailable, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTemplateColumn Header="Estado" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="t" Text="Activo" Foreground="{StaticResource AccentDarkBrush}" FontWeight="SemiBold"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Active}" Value="False">
                                        <Setter TargetName="t" Property="Text" Value="Inactivo"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
