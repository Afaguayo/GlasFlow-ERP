<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GlasFlow.Desktop.ViewModels">

    <DataTemplate DataType="{x:Type vm:SalesOrdersViewModel}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Pedidos de venta" Style="{StaticResource H1}" Margin="0,0,0,12"/>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <WrapPanel>
                    <TextBox Width="220" Margin="0,0,10,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por número o cliente">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <ComboBox Width="180" Margin="0,0,10,0" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding Status}"/>
                    <Button Content="Buscar" Style="{StaticResource Primary}" Command="{Binding SearchCommand}"/>
                    <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,24,0"/>
                    <Button Content="Nuevo pedido…" Command="{Binding NewCommand}"/>
                </WrapPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Siguiente ›" Command="{Binding NextCommand}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="‹ Anterior" Command="{Binding PrevCommand}" Margin="0"/>
                        <TextBlock Text="{Binding PageText}" Style="{StaticResource Muted}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pedido" Binding="{Binding OrderNumber}" Width="105"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="2*"/>
                            <DataGridTemplateColumn Header="Estado" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding Status, Converter={StaticResource StatusConverter}, ConverterParameter=bg}">
                                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding Status, Converter={StaticResource StatusConverter}, ConverterParameter=label}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusConverter}, ConverterParameter=fg}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Detail pane -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock Text="Seleccione un pedido para ver el detalle." Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                   Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>
                        <DockPanel Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}">
                            <StackPanel DockPanel.Dock="Top" DataContext="{Binding Detail}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="10,3"
                                            Background="{Binding Status, Converter={StaticResource StatusConverter}, ConverterParameter=bg}">
                                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding Status, Converter={StaticResource StatusConverter}, ConverterParameter=label}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusConverter}, ConverterParameter=fg}"/>
                                    </Border>
                                    <TextBlock Text="{Binding OrderNumber}" Style="{StaticResource H1}" FontSize="18"/>
                                </DockPanel>
                                <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Style="{StaticResource Muted}"><Run Text="RFC:"/> <Run Text="{Binding CustomerRfc, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Muted}"><Run Text="Almacén:"/> <Run Text="{Binding WarehouseName, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Muted}"><Run Text="Fecha:"/> <Run Text="{Binding OrderDate, StringFormat=dd/MM/yyyy HH:mm, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Muted}" Visibility="{Binding ExternalReference, Converter={StaticResource NullToVisibility}}"><Run Text="Ref. externa:"/> <Run Text="{Binding ExternalReference, Mode=OneWay}"/></TextBlock>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding Notes, Converter={StaticResource NullToVisibility}}"><Run Text="Notas:"/> <Run Text="{Binding Notes, Mode=OneWay}"/></TextBlock>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Grid DataContext="{Binding Detail}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Subtotal" Style="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=C2}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1">
                                        <Run Text="IVA ("/><Run Text="{Binding TaxRate, StringFormat=P0, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tax, StringFormat=C2}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Text="Total" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Total, StringFormat=C2}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentDarkBrush}"/>
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Confirmar" Style="{StaticResource Primary}" Command="{Binding ConfirmCommand}"/>
                                    <Button Content="Embarcar" Style="{StaticResource Primary}" Command="{Binding ShipCommand}"/>
                                    <Button Content="Cancelar pedido" Style="{StaticResource Danger}" Command="{Binding CancelOrderCommand}"/>
                                </WrapPanel>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Detail.Lines}" Margin="0,12,0,0" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="2*"/>
                                    <DataGridTextColumn Header="Cant." Binding="{Binding Quantity, StringFormat=N2}" Width="70"/>
                                    <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat=C2}" Width="90"/>
                                    <DataGridTextColumn Header="Importe" Binding="{Binding LineTotal, StringFormat=C2}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
