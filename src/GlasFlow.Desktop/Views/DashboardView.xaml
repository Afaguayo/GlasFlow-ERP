<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GlasFlow.Desktop.ViewModels">

    <DataTemplate x:Key="KpiTemplate">
        <Border Style="{StaticResource KpiTile}">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Value}" Style="{StaticResource KpiValue}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Content="Actualizar" Style="{StaticResource Primary}" Command="{Binding RefreshCommand}" Margin="0"/>
                    <StackPanel>
                        <TextBlock Text="Tablero" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Visibility="{Binding GeneratedAt, Converter={StaticResource NullToVisibility}}">
                            <Run Text="Generado:"/> <Run Text="{Binding GeneratedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- KPI tiles -->
                <WrapPanel DataContext="{Binding Kpis}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <Border Style="{StaticResource KpiTile}"><StackPanel>
                        <TextBlock Text="Ventas del mes" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding SalesThisMonth, StringFormat=C2}" Style="{StaticResource KpiValue}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="Mes anterior:"/> <Run Text="{Binding SalesLastMonth, StringFormat=C2, Mode=OneWay}"/></TextBlock>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiTile}"><StackPanel>
                        <TextBlock Text="Pedidos pendientes" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding PendingOrders}" Style="{StaticResource KpiValue}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="Confirmados:"/> <Run Text="{Binding ConfirmedOrders, Mode=OneWay}"/></TextBlock>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiTile}"><StackPanel>
                        <TextBlock Text="Valor de inventario" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding InventoryValue, StringFormat=C0}" Style="{StaticResource KpiValue}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiTile}"><StackPanel>
                        <TextBlock Text="Productos con stock bajo" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding LowStockProducts}" Style="{StaticResource KpiValue}" Foreground="{StaticResource WarnBrush}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiTile}"><StackPanel>
                        <TextBlock Text="Órdenes de producción" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding ActiveProductionOrders}" Style="{StaticResource KpiValue}"/>
                        <ProgressBar Value="{Binding ProductionProgressPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,2" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="{Binding ProductionProgressPercent, StringFormat=N0, Mode=OneWay}"/><Run Text="% de avance"/></TextBlock>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiTile}"><StackPanel>
                        <TextBlock Text="Notificaciones sin leer" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding UnreadNotifications}" Style="{StaticResource KpiValue}"/>
                    </StackPanel></Border>
                </WrapPanel>

                <!-- Sales chart (WPF shapes) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Ventas de los últimos 12 meses" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding Bars}" Height="200">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0" ToolTip="{Binding Tooltip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Total, StringFormat=C0}" FontSize="10" HorizontalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                                            <Rectangle Height="{Binding BarHeight}" Fill="{StaticResource AccentBrush}" RadiusX="3" RadiusY="3"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource Muted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Stock bajo" Style="{StaticResource H2}"/>
                            <DataGrid ItemsSource="{Binding LowStock}" MaxHeight="260" RowStyle="{StaticResource LowStockRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="2*"/>
                                    <DataGridTextColumn Header="Almacén" Binding="{Binding WarehouseCode}" Width="80"/>
                                    <DataGridTextColumn Header="Disp." Binding="{Binding QuantityAvailable, StringFormat=N2}" Width="80"/>
                                    <DataGridTextColumn Header="Mín." Binding="{Binding MinimumStock, StringFormat=N2}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pedidos recientes" Style="{StaticResource H2}"/>
                            <DataGrid ItemsSource="{Binding RecentOrders}" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pedido" Binding="{Binding OrderNumber}" Width="110"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="2*"/>
                                    <DataGridTemplateColumn Header="Estado" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left"
                                                        Background="{Binding Status, Converter={StaticResource StatusConverter}, ConverterParameter=bg}">
                                                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding Status, Converter={StaticResource StatusConverter}, ConverterParameter=label}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusConverter}, ConverterParameter=fg}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
