<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GlasFlow.Desktop.ViewModels">

    <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Inventario" Style="{StaticResource H1}" Margin="0,0,0,12"/>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <WrapPanel>
                    <TextBox Width="220" Margin="0,0,10,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por código o nombre">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <ComboBox Width="190" Margin="0,0,10,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
                    <ComboBox Width="200" Margin="0,0,10,0" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}"/>
                    <CheckBox Content="Solo stock bajo" Margin="0,0,14,0" IsChecked="{Binding LowStockOnly}"/>
                    <Button Content="Buscar" Style="{StaticResource Primary}" Command="{Binding SearchCommand}"/>
                    <Button Content="Actualizar" Command="{Binding RefreshCommand}"/>
                    <Button Content="Ajustar stock…" Command="{Binding AdjustCommand}"/>
                </WrapPanel>
            </Border>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Siguiente ›" Command="{Binding NextCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="‹ Anterior" Command="{Binding PrevCommand}" Margin="0"/>
                <TextBlock Text="{Binding PageText}" Style="{StaticResource Muted}"/>
            </DockPanel>

            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" RowStyle="{StaticResource LowStockRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding ProductCode}" Width="110"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="2*"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="*"/>
                    <DataGridTextColumn Header="Almacén" Binding="{Binding WarehouseCode}" Width="90"/>
                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="60"/>
                    <DataGridTextColumn Header="Disponible" Binding="{Binding QuantityAvailable, StringFormat=N2}" Width="95"/>
                    <DataGridTextColumn Header="Reservado" Binding="{Binding QuantityReserved, StringFormat=N2}" Width="95"/>
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding MinimumStock, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="Valor" Binding="{Binding StockValue, StringFormat=C2}" Width="115"/>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left" Background="{StaticResource WarnSoftBrush}"
                                        Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Stock bajo" Style="{StaticResource ChipText}" Foreground="{StaticResource WarnBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
