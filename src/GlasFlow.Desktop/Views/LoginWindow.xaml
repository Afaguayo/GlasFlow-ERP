<Window x:Class="GlasFlow.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlasFlow ERP — Escritorio" Width="440" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource SidebarBrush}" Padding="32,28">
            <StackPanel>
                <TextBlock Text="GlasFlow ERP" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Cristales y vidrio — Chihuahua, México" Foreground="#9CA3AF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="32,20">
            <TextBlock Text="Iniciar sesión" Style="{StaticResource H2}"/>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
            </Border>
            <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NotBusy}"/>
            <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" IsEnabled="{Binding NotBusy}"/>
            <Button Content="Entrar" Style="{StaticResource Primary}" Command="{Binding LoginCommand}" IsDefault="True"
                    Margin="0,20,0,0" Height="36"/>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap">
                <Run Text="API:"/> <Run Text="{Binding ApiUrl, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
