<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GlasFlow.Desktop.ViewModels">

    <!-- Stock adjustment -->
    <DataTemplate DataType="{x:Type vm:StockAdjustDialogViewModel}">
        <StackPanel Width="420">
            <TextBlock Text="Ajuste de inventario" Style="{StaticResource H1}" FontSize="18"/>
            <Border Style="{StaticResource ErrorBanner}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
            </Border>
            <TextBlock Text="Producto" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding ProductText}" FontWeight="SemiBold"/>
            <TextBlock Text="Almacén" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding WarehouseText}"/>
            <TextBlock Text="Existencia actual" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding CurrentText}"/>
            <TextBlock Text="Cantidad a ajustar (positivo suma, negativo resta)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Motivo" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True"/>
                <Button Content="Guardar ajuste" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Product create / edit -->
    <DataTemplate DataType="{x:Type vm:ProductDialogViewModel}">
        <StackPanel Width="520">
            <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource H1}" FontSize="18"/>
            <Border Style="{StaticResource ErrorBanner}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Código" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ProductCode}"/>
                    <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
                    <TextBlock Text="Costo (MXN)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Cost}"/>
                    <TextBlock Text="Existencia mínima" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding MinimumStock}"/>
                    <TextBlock Text="Proveedor" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedValuePath="Id" SelectedValue="{Binding SupplierId}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ID externo (opcional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ExternalId}"/>
                    <TextBlock Text="Unidad" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}"/>
                    <TextBlock Text="Precio de venta (MXN)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SellingPrice}"/>
                    <TextBlock Text="Activo" Style="{StaticResource FieldLabel}"/>
                    <CheckBox IsChecked="{Binding Active}" Content="Producto activo" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ProductName}"/>
            <TextBlock Text="Descripción" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True"/>
                <Button Content="Guardar" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- New sales order -->
    <DataTemplate DataType="{x:Type vm:NewOrderDialogViewModel}">
        <StackPanel Width="640">
            <TextBlock Text="Nuevo pedido de venta" Style="{StaticResource H1}" FontSize="18"/>
            <Border Style="{StaticResource ErrorBanner}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
            </Border>

            <!-- Editing -->
            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Cliente" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Almacén" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Notas" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Referencia externa (evita duplicados)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ExternalReference, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Partidas" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding LineProduct}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Cantidad"/>
                    <Button Grid.Column="2" Content="Agregar" Command="{Binding AddLineCommand}" Margin="0"/>
                </Grid>
                <DataGrid ItemsSource="{Binding Lines}" Height="170" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Text}" Width="2*"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="60"/>
                        <DataGridTextColumn Header="Precio lista" Binding="{Binding ListPrice, StringFormat=C2}" Width="100"/>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Padding="6,0" MinHeight="24" Margin="0" Style="{StaticResource Danger}"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Los precios mostrados son de catálogo. El servidor calcula subtotal, IVA y total al guardar."/>
            </StackPanel>

            <!-- Saved: server-computed totals -->
            <StackPanel Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}" DataContext="{Binding Created}" Margin="0,12,0,0">
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="14,10">
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}">
                        <Run Text="Pedido"/> <Run Text="{Binding OrderNumber, Mode=OneWay}"/> <Run Text="guardado como Borrador."/>
                    </TextBlock>
                </Border>
                <Grid Margin="0,14,0,0" Width="280" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Subtotal" Style="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=C2}"/>
                    <TextBlock Grid.Row="1"><Run Text="IVA ("/><Run Text="{Binding TaxRate, StringFormat=P0, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tax, StringFormat=C2}"/>
                    <TextBlock Grid.Row="2" Text="Total" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Total, StringFormat=C2}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentDarkBrush}"/>
                </Grid>
                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Totales calculados por el servidor. Confirme el pedido desde la lista para reservar stock."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Command="{Binding CancelCommand}" IsCancel="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Cancelar"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                    <Setter Property="Content" Value="Cerrar"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Guardar pedido" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" Margin="0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
