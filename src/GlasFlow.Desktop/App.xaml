<Application x:Class="GlasFlow.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Styles.xaml"/>
                <ResourceDictionary Source="Views/DashboardView.xaml"/>
                <ResourceDictionary Source="Views/InventoryView.xaml"/>
                <ResourceDictionary Source="Views/ProductsView.xaml"/>
                <ResourceDictionary Source="Views/SalesOrdersView.xaml"/>
                <ResourceDictionary Source="Views/DialogViews.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
